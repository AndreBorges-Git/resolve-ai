# Imagem de producao do front. O Dockerfile ao lado continua servindo o
# servidor de desenvolvimento usado pelo docker-compose.
FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# O Vite congela import.meta.env no momento do build, entao a URL da API
# precisa entrar aqui e nao como variavel de ambiente do container.
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
